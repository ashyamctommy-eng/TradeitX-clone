# ---- core ----
DATABASE_URL="file:./dev.db"          # swap to postgresql://… for production
JWT_SECRET="change-me-in-production"
API_PORT=4000
API_URL="http://127.0.0.1:4000"       # used by Next rewrites

# ---- money movement ----
# Master switch for real deposits/withdrawals. Keep false until licensed + KYC live.
ENABLE_LIVE_PAYMENTS=true

# ---- PalPluss (M-Pesa) ----
PALPLUSS_API_KEY=""                   # pp_live_… / pp_test_… (any prefix accepted)
PALPLUSS_ENV="sandbox"                # sandbox | live
# Public HTTPS base used in callbackUrl — ngrok in local dev
PUBLIC_URL="http://localhost:4000"

# ---- crypto (NOWPayments) ----
NOWPAYMENTS_SANDBOX=true              # true → local invoices, no outbound calls
NOWPAYMENTS_API_KEY=""
NOWPAYMENTS_IPN_SECRET="sandbox-ipn-secret"

# ---- admin telegram bot (optional) ----
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_CHAT_ID=""
